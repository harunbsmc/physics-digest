    def day_label(ts):
        d = time.localtime(ts)
        today = time.localtime()
        days = (time.mktime((today.tm_year, today.tm_mon, today.tm_mday, 0, 0, 0, 0, 0, -1)) -
                time.mktime((d.tm_year, d.tm_mon, d.tm_mday, 0, 0, 0, 0, 0, -1))) // 86400
        if days <= 0:
            return "Today"
        if days == 1:
            return "Yesterday"
        return time.strftime("%A, %d %B", d)

    _math_cache = {}

    def render_math(tex, color, size_pt):
        key = (tex, color, size_pt)
        if key in _math_cache:
            return _math_cache[key]
        res = None
        try:
            import matplotlib
            matplotlib.use("Agg")
            import numpy as np
            from matplotlib import mathtext, font_manager
            from gi.repository import GdkPixbuf
            matplotlib.rcParams["mathtext.fontset"] = "cm"
            t = re.sub(r"\\text\{", r"\\mathrm{", tex)
            t = re.sub(r"\\operatorname\{", r"\\mathrm{", t)
            r = mathtext.MathTextParser("agg").parse(f"${t}$", dpi=96,
                                                     prop=font_manager.FontProperties(size=size_pt))
            alpha = np.asarray(r.image, dtype=np.uint8)
            h, w = alpha.shape
            rgba = np.zeros((h, w, 4), dtype=np.uint8)
            rgba[..., 0], rgba[..., 1], rgba[..., 2] = (int(color[i:i + 2], 16) for i in (1, 3, 5))
            rgba[..., 3] = alpha
            pix = GdkPixbuf.Pixbuf.new_from_bytes(GLib.Bytes.new(rgba.tobytes()), GdkPixbuf.Colorspace.RGB,
                                                  True, 8, w, h, w * 4)
            res = (pix, int(round(r.depth)))
        except Exception:
            res = None
        _math_cache[key] = res
        return res

    def run_bg(work, done):
        """Run work() in a thread, then done(result) on the GTK thread."""
        def t():
            try:
                r = work()
            except Exception as e:
                r = e
            GLib.idle_add(lambda: done(r) and False)
        threading.Thread(target=t, daemon=True).start()

