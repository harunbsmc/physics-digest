    class Clamp(Gtk.Bin):
        """Centres its child in a column of at most max_w pixels, without forcing the window wider."""
        __gtype_name__ = "PhysicsDigestClamp"

        def __init__(self, child, max_w):
            super().__init__()
            self.max_w = max_w
            self.add(child)

        def do_get_request_mode(self):
            return Gtk.SizeRequestMode.HEIGHT_FOR_WIDTH

        def do_get_preferred_width(self):
            mn, nat = self.get_child().get_preferred_width()
            return mn, max(mn, min(nat, self.max_w))

        def _inner(self, width):
            mn, _ = self.get_child().get_preferred_width()
            return max(mn, min(width, self.max_w))

        def do_get_preferred_height_for_width(self, width):
            return self.get_child().get_preferred_height_for_width(self._inner(width))

        def do_get_preferred_height(self):
            return self.get_child().get_preferred_height_for_width(self.max_w)

        def do_get_preferred_width_for_height(self, height):
            return self.do_get_preferred_width()

        def do_size_allocate(self, alloc):
            self.set_allocation(alloc)
            w = self._inner(alloc.width)
            child = Gdk.Rectangle()
            child.x = alloc.x + (alloc.width - w) // 2
            child.y = alloc.y
            child.width = w
            child.height = alloc.height
            self.get_child().size_allocate(child)

