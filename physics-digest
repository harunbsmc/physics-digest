        def make_textview(self):
            tv = Gtk.TextView()
            tv.set_editable(False)
            tv.set_cursor_visible(False)
            tv.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
            tv.set_pixels_inside_wrap(5)
            tv.set_pixels_below_lines(8)
            tv.get_style_context().add_class("dg-body")
            tv.last_w = 0

            def on_alloc(view, alloc):
                # GTK3 text views keep a height computed for an old width; re-measure when the width changes
                if alloc.width != view.last_w:
                    view.last_w = alloc.width
                    GLib.idle_add(lambda: self.relayout(view) and False)
            tv.connect("size-allocate", on_alloc)
            return tv

        def relayout(self, tv):
            buf = tv.get_buffer()
            buf.begin_user_action()
            end = buf.get_end_iter()
            buf.insert(end, " ")
            end = buf.get_end_iter()
            start = end.copy()
            start.backward_char()
            buf.delete(start, end)
            buf.end_user_action()
            tv.queue_resize()

        def fill_text(self, tv, text):
            """Text with $...$ math drawn as LaTeX (readable Unicode if rendering fails)."""
            buf = tv.get_buffer()
            buf.set_text("")
            rgba = tv.get_style_context().get_color(Gtk.StateFlags.NORMAL)
            color = "#%02x%02x%02x" % (int(rgba.red * 255), int(rgba.green * 255), int(rgba.blue * 255))
            last = 0
            for m in MATH.finditer(text):
                buf.insert(buf.get_end_iter(), text[last:m.start()])
                tex = next(g for g in m.groups() if g is not None)
                res = render_math(tex, color, 13)
                if res is not None:
                    pix, depth = res
                    start = buf.get_end_iter().get_offset()
                    buf.insert_pixbuf(buf.get_end_iter(), pix)
                    if depth:
                        tag = buf.create_tag(None, rise=-depth * Pango.SCALE)
                        buf.apply_tag(tag, buf.get_iter_at_offset(start), buf.get_end_iter())
                else:
                    buf.insert_markup(buf.get_end_iter(), tex_to_markup(tex), -1)
                last = m.end()
            buf.insert(buf.get_end_iter(), text[last:])

        def show_detail(self, item_id):
            it = self.app.store.get(item_id)
            if it is None:
                return
            self.app.store.mark_read(item_id)
            self.current = self.app.store.get(item_id)
            it = self.current
            self.d_title.set_markup(text_to_markup(it["title"] or "(untitled)"))
            for ch in self.d_metabox.get_children():
                self.d_metabox.remove(ch)
            if it["level"]:
                self.d_metabox.pack_start(level_pill(it["level"]), False, False, 0)
            self.d_meta.set_text(meta_text(it).replace("  ·  ✎ note", ""))
            self.d_metabox.pack_start(self.d_meta, True, True, 0)
            self.d_metabox.show_all()
            tags = it["tags"] if it["kind"] == "paper" else ""
            self.d_tags.set_markup("<small>" + GLib.markup_escape_text(tags) + "</small>" if tags else "")
            self.d_tags.set_visible(bool(tags))
            self.d_why_h.set_visible(bool(it["why"]))
            self.d_why.set_visible(bool(it["why"]))
            self.d_why.set_markup(text_to_markup(it["why"] or ""))
            self.show_explanation(it["explain"])
            self.d_exp_spin.stop()
            text = it["summary"] or ""
            self.d_abs_h.set_text("Summary" if it["kind"] == "news" else "Abstract")
            self.d_abs_h.set_visible(bool(text))
            self.d_abs.set_visible(bool(text))
            self.fill_text(self.d_abs, text)
            self.d_note.set_text(it["note"] or "")
            is_paper = bool(arxiv_id(it["link"]))
            self.b_open.set_label("arXiv" if is_paper else "Open")
            self.b_open.set_tooltip_text("Open the page in your browser (O)")
            for b in (self.b_pdf, self.b_bib, self.b_explain):
                b.set_visible(is_paper)
            self.update_save_button()
            self.d_status.set_text("")
            self.d_scroll.get_vadjustment().set_value(0)
            self.pages.set_visible_child_name("detail")
            self.update_status()

        def show_explanation(self, text):
            has = bool(text)
            self.d_exp_h.set_visible(has)
            self.d_exp.set_visible(has)
            if has:
                self.fill_text(self.d_exp, text)

        def update_save_button(self):
            saved = bool(self.current and self.current["saved"])
            self.d_save.set_label("★  Saved" if saved else "☆  Save")
            self.d_save.set_tooltip_text("Remove from Saved (S)" if saved else "Save for later (S)")

        def show_list(self):
            keep = self.current["id"] if self.current else None
            self.save_note()
            self.current = None
            self.pages.set_visible_child_name("list")
            self.reload(keep=keep)

        # ================================================================ actions
        def in_detail(self):
            return self.pages.get_visible_child_name() == "detail"

        def say(self, msg):
            if self.in_detail():
                self.d_status.set_text(msg)
            else:
                self.update_status(note=msg)

        def open_url(self, url):
            if url:
                subprocess.Popen(["xdg-open", url], start_new_session=True,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        def copy(self, text, msg):
            Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(text, -1)
            self.say(msg)

        def toggle_save(self, item_id):
            it = self.app.store.get(item_id)
            if it is None:
                return
            self.app.store.set_field(item_id, "saved", 0 if it["saved"] else 1)
            if self.in_detail() and self.current and self.current["id"] == item_id:
                self.current = self.app.store.get(item_id)
                self.update_save_button()
                self.say("Saved" if self.current["saved"] else "Removed from Saved")
            else:
                self.reload(keep=item_id)

        def save_note(self):
            if self.current is None:
                return
            text = self.d_note.get_text().strip()
            if text != (self.current["note"] or ""):
                self.app.store.set_field(self.current["id"], "note", text)
                self.current = self.app.store.get(self.current["id"])
                self.say("Note saved")

        def delete(self, item_id):
            self.app.store.dismiss(item_id)
            if self.in_detail():
                self.current = None
                self.pages.set_visible_child_name("list")
                self.reload()
            else:
                lb = self.current_list()
                rows = lb.get_children()
                ids = [r.item_id for r in rows]
                nxt = ids[ids.index(item_id) + 1] if item_id in ids and ids.index(item_id) + 1 < len(ids) else None
                self.reload(keep=nxt)

        def restore(self):
            n = self.app.store.restore_latest()
            self.reload()
            self.update_status(note=f"Restored {n} item{'s' if n != 1 else ''}")

        def open_pdf(self):
            it = self.current
            aid = arxiv_id(it["link"]) if it else None
            if not aid:
                return
            folder = os.path.expanduser(self.app.cfg.get("papers_dir", "~/Papers"))
            short = re.sub(r"[^\w\- ]", "", it["title"])[:60].strip()
            path = os.path.join(folder, f"{aid.replace('/', '_')} - {short}.pdf")
            if os.path.exists(path):
                self.open_url(path)
                self.say(f"Opened {os.path.basename(path)}")
                return
            self.say("Downloading PDF…")
            self.b_pdf.set_sensitive(False)

            def work():
                os.makedirs(folder, exist_ok=True)
                data = fetch(f"https://arxiv.org/pdf/{aid}")
                if not data.startswith(b"%PDF"):
                    raise ValueError("arXiv did not return a PDF")
                with open(path + ".part", "wb") as f:
                    f.write(data)
                os.replace(path + ".part", path)
                return path

            def done(r):
                self.b_pdf.set_sensitive(True)
                if isinstance(r, Exception):
                    self.say("Download failed, opening in the browser instead")
                    self.open_url(f"https://arxiv.org/pdf/{aid}")
                else:
                    self.open_url(r)
                    self.say(f"Saved to {folder.replace(HOME, '~')}")
            run_bg(work, done)

        def copy_bibtex(self):
            it = self.current
            aid = arxiv_id(it["link"]) if it else None
            if not aid:
                return
            if it["bibtex"]:
                self.copy(it["bibtex"], "BibTeX copied")
                return
            self.say("Getting BibTeX…")
            item_id = it["id"]

            def work():
                txt = fetch(f"https://arxiv.org/bibtex/{aid}").decode("utf-8", "replace").strip()
                if not txt.startswith("@"):
                    raise ValueError("no BibTeX")
                return txt

            def done(r):
                bib = fallback_bibtex(it) if isinstance(r, Exception) else r
                self.app.store.set_field(item_id, "bibtex", bib)
                if self.current and self.current["id"] == item_id:
                    self.current = self.app.store.get(item_id)
                self.copy(bib, "BibTeX copied" + (" (built locally)" if isinstance(r, Exception) else ""))
            run_bg(work, done)

        def explain(self):
            it = self.current
            if not it or not arxiv_id(it["link"]):
                return
            if it["explain"]:
                self.show_explanation(it["explain"])
                return
            if not shutil.which("claude"):
                self.say("Explain needs Claude Code (the 'claude' command) to be installed and signed in")
                return
            item_id = it["id"]
            self.b_explain.set_sensitive(False)
            self.d_exp_h.set_visible(True)
            self.d_exp_spin.start()
            self.say("Claude is reading the abstract…")
            prompt = (
                "Reader profile: " + self.app.cfg.get("profile", "") + "\n\n"
                f"Paper: {it['title']}\nAuthors: {it['authors']}\nAbstract: {it['summary']}\n\n"
                "Explain this paper to this reader in 4-5 plain sentences: the question, the main idea, and why "
                "it matters. Then add one line starting with 'Before reading:' listing the 2-4 concepts they "
                "should be comfortable with. Use $...$ for any math. No headings, no bullet points, English only.")

            def work():
                r = subprocess.run(["claude", "-p", prompt], capture_output=True, text=True, timeout=300)
                if r.returncode != 0 or not r.stdout.strip():
                    raise RuntimeError(r.stderr.strip()[:200] or "no answer")
                return r.stdout.strip()

            def done(r):
                self.b_explain.set_sensitive(True)
                self.d_exp_spin.stop()
                if isinstance(r, Exception):
                    self.d_exp_h.set_visible(False)
                    self.say(f"Explain failed: {r}")
                    return
                self.app.store.set_field(item_id, "explain", r)
                if self.current and self.current["id"] == item_id:
                    self.current = self.app.store.get(item_id)
                    self.show_explanation(r)
                    self.say("")
            run_bg(work, done)

        def ask_claude(self):
            it = self.current
            if not it:
                return
            aid = arxiv_id(it["link"])
            prompt = (f"I'd like to discuss this paper: \"{it['title']}\" by {it['authors']}.\n"
                      f"Link: {it['link']}\n" + (f"PDF: https://arxiv.org/pdf/{aid}\n" if aid else "") +
                      "Please read it first. About me: " + self.app.cfg.get("profile", "") + "\n"
                      "Give me a short overview of the main result and how it is obtained, "
                      "then I'll ask my questions.")
            Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(prompt, -1)
            url = self.app.cfg.get("ask_claude_url", "https://claude.ai/new?q={prompt}")
            self.open_url(url.replace("{prompt}", urllib.parse.quote(prompt)))
            self.say("Opening Claude… the message is also on your clipboard (Ctrl+V if the box is empty)")

        # ================================================================ keys & refresh
        def on_key(self, _w, ev):
            focus = self.get_focus()
            typing = isinstance(focus, Gtk.Entry) or (isinstance(focus, Gtk.TextView) and focus.get_editable())
            ctrl = ev.state & Gdk.ModifierType.CONTROL_MASK
            k = ev.keyval
            if k == Gdk.KEY_Escape:
                if typing and focus is self.search and self.search.get_text():
                    self.search.set_text("")
                elif self.in_detail():
                    self.show_list()
                else:
                    self.close()
                return True
            if ctrl and k in (Gdk.KEY_f, Gdk.KEY_F) and not self.in_detail():
                self.search.grab_focus()
                return True
            if ctrl and k in (Gdk.KEY_r, Gdk.KEY_R):
                self.refresh()
                return True
            if typing or ctrl:
                return False
            ch = Gdk.keyval_to_unicode(k)
            ch = chr(ch).lower() if ch else ""
            sel = None
            if not self.in_detail():
                row = self.current_list().get_selected_row()
                sel = row.item_id if row else None
            if ch == "j":
                self.move(1) if not self.in_detail() else None
            elif ch == "k":
                self.move(-1) if not self.in_detail() else None
            elif k == Gdk.KEY_Delete:
                target = self.current["id"] if self.in_detail() and self.current else sel
                if target:
                    self.delete(target)
            elif ch == "s":
                target = self.current["id"] if self.in_detail() and self.current else sel
                if target:
                    self.toggle_save(target)
            elif self.in_detail() and ch in ("o", "p", "e", "b", "a"):
                {"o": lambda: self.open_url(self.current["link"]), "p": self.open_pdf, "e": self.explain,
                 "b": self.copy_bibtex, "a": self.ask_claude}[ch]()
            elif not self.in_detail() and ch == "o" and sel:
                it = self.app.store.get(sel)
                self.app.store.mark_read(sel)
                self.open_url(it["link"])
                self.reload(keep=sel)
            else:
                return False
            return True

        def refresh(self):
            if self.fetching:
                return
            self.fetching = True
            self.update_status()

            def work():
                return locked_fetch(load_conf(), Store(DB), lambda m: print(m, file=sys.stderr))

            def done(_r):
                self.fetching = False
                if self.in_detail():
                    self.update_status()
                else:
                    self.reload()
            run_bg(work, done)

    class DigestApp(Gtk.Application):
        def __init__(self):
            super().__init__(application_id="org.physicsdigest.PhysicsDigest",
                             flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
            self.window = None

        def do_startup(self):
            Gtk.Application.do_startup(self)
            self.cfg = load_conf()
            self.store = Store(DB)

        def do_command_line(self, cl):
            args = cl.get_arguments()[1:]
            if self.window is None:
                self.window = DigestWindow(self)
                self.window.connect("destroy", lambda *_: setattr(self, "window", None))
            if "--show" in args and args.index("--show") + 1 < len(args):
                self.window.show_detail(args[args.index("--show") + 1])
            elif "--tab" in args and args.index("--tab") + 1 < len(args):
                if self.window.in_detail():
                    self.window.show_list()
                self.window.tabs.set_visible_child_name(args[args.index("--tab") + 1])
            elif self.window.in_detail():
                self.window.show_list()
            self.window.present()
            return 0

    return DigestApp().run(sys.argv)


if __name__ == "__main__":
    a = sys.argv[1:]
    if "--version" in a:
        print(f"physics-digest {__version__}")
    elif "--daemon" in a:
        main_daemon()
    elif "--refresh" in a:
        if not call_daemon("Refresh"):
            print("Background service is not running; fetching here instead.")
            print(locked_fetch(load_conf(), Store(DB)) and "done")
    elif "--quit" in a:
        print("stopped" if call_daemon("Quit") else "Background service is not running.")
    elif "--restore" in a:
        st = Store(DB)
        n = st.restore_latest()
        write_unread(st, load_conf())
        print(f"Restored {n} item(s).")
    elif "--reset" in a:
        for f in (DB, os.path.join(CACHE, "unread")):
            if os.path.exists(f):
                os.remove(f)
        print("Physics Digest reset. The next check fetches the current arXiv listing again.")
    elif "--fetch-once" in a:
        r = locked_fetch(load_conf(), Store(DB))
        print(json.dumps({k: len(v) for k, v in r.items()}) if r else "another fetch is running")
    else:
        sys.exit(main_gui())
