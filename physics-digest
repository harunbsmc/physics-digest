def _group(s, i):
    """Return (content, next index) for {...} or a single token at s[i]."""
    if i < len(s) and s[i] == "{":
        depth, j = 0, i
        while j < len(s):
            depth += {"{": 1, "}": -1}.get(s[j], 0)
            if depth == 0:
                return s[i+1:j], j + 1
            j += 1
        return s[i+1:], len(s)
    if i < len(s) and s[i] == "\\":
        m = re.match(r"\\[A-Za-z]+", s[i:])
        if m:
            return m.group(0), i + len(m.group(0))
    return s[i:i+1], i + 1

def tex_to_markup(tex):
    """LaTeX math -> Pango markup (Unicode symbols, <sup>/<sub>)."""
    out, i = [], 0
    while i < len(tex):
        c = tex[i]
        if c == "\\":
            m = re.match(r"\\([A-Za-z]+)|\\(.)", tex[i:])
            name = m.group(1) or m.group(2)
            i += len(m.group(0))
            if name in ("mathbb", "mathbbm"):
                g, i = _group(tex, i); out.append("".join(BB.get(ch, ch) for ch in g))
            elif name in ("mathrm", "text", "mathit", "mathbf", "mathcal", "mathsf", "operatorname", "textrm", "mathfrak"):
                g, i = _group(tex, i); out.append(tex_to_markup(g))
            elif name in ("frac", "dfrac", "tfrac"):
                a, i = _group(tex, i); b, i = _group(tex, i)
                a, b = tex_to_markup(a), tex_to_markup(b)
                wrap = lambda x: f"({x})" if re.search(r"[+\-\s]", re.sub(r"<[^>]+>", "", x)) else x
                out.append(f"{wrap(a)}/{wrap(b)}")
            elif name == "sqrt":
                g, i = _group(tex, i); g = tex_to_markup(g)
                out.append("√" + (g if len(re.sub(r"<[^>]+>", "", g)) == 1 else f"({g})"))
            elif name in ("left", "right", "big", "Big", "bigg", "Bigg", "displaystyle", "limits", "nonumber"):
                pass
            elif name in ("bar", "overline"):
                g, i = _group(tex, i); out.append(tex_to_markup(g) + "\u0305")
            elif name in ("hat", "widehat"):
                g, i = _group(tex, i); out.append(tex_to_markup(g) + "\u0302")
            elif name in ("tilde", "widetilde"):
                g, i = _group(tex, i); out.append(tex_to_markup(g) + "\u0303")
            elif name in ("vec",):
                g, i = _group(tex, i); out.append(tex_to_markup(g) + "\u20d7")
            elif name == "dot":
                g, i = _group(tex, i); out.append(tex_to_markup(g) + "\u0307")
            elif name in (",", ";", ":", " ", "!"):
                out.append("" if name == "!" else "\u2009")
            elif name in ("{", "}", "%", "&", "#", "_", "$"):
                out.append(html.escape(name))
            elif name in GREEK:
                out.append(GREEK[name])
            elif name in SYM:
                out.append(SYM[name])
            else:
                out.append(html.escape(name))
        elif c in "^_":
            g, i = _group(tex, i + 1)
            inner = tex_to_markup(g)
            plain = re.sub(r"<[^>]+>", "", inner)
            table = SUP if c == "^" else SUB
            conv = plain.translate(table)
            if all(ch != o or ch in " " for ch, o in zip(conv, plain)) and "&" not in inner and "<" not in inner:
                out.append(conv)
            else:
                tag = "sup" if c == "^" else "sub"
                out.append(f"<{tag}>{inner}</{tag}>")
        elif c in "{}":
            i += 1
        else:
            out.append(html.escape(c)); i += 1
    return "".join(out)

def text_to_markup(text):
    """Plain text with $...$ math -> Pango markup."""
    res, last = [], 0
    for m in MATH.finditer(text):
        res.append(html.escape(text[last:m.start()]))
        tex = next(g for g in m.groups() if g is not None)
        res.append(tex_to_markup(tex))
        last = m.end()
    res.append(html.escape(text[last:]))
    return "".join(res)


