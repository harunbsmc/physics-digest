#!/usr/bin/env python3
"""Physics Digest - a daily, Claude-curated digest of new arXiv papers and physics news for the Linux desktop.

  physics-digest               open the window
  physics-digest --tab NAME    open the window on a tab: picks, foryou, news, saved
  physics-digest --show ID     open the window on one item
  physics-digest --daemon      background service: checks feeds and sends notifications (used at login)
  physics-digest --refresh     ask the background service to check now
  physics-digest --quit        stop the background service
  physics-digest --fetch-once  fetch once in the terminal and print what was found
  physics-digest --version     print the version
  physics-digest --restore     bring back everything you deleted from the latest day's items
  physics-digest --reset       forget everything (also deleted items) and start completely fresh
"""
import html, json, os, re, shutil, sqlite3, subprocess, sys, threading, time
import urllib.parse, urllib.request
import xml.etree.ElementTree as ET

HOME = os.path.expanduser("~")
CONF = os.path.join(HOME, ".config/physics-digest/config.json")
DB = os.path.join(HOME, ".local/share/physics-digest/items.db")
__version__ = "1.0.0"
ICON = os.path.join(HOME, ".local/share/icons/physics-digest.svg")
CACHE = os.path.join(HOME, ".cache/physics-digest")
SELF = os.path.realpath(__file__)
BUS_NAME, BUS_PATH = "org.physicsdigest.PhysicsDigest.Daemon", "/org/physicsdigest/PhysicsDigest/Daemon"
os.environ["PATH"] = os.path.join(HOME, ".local/bin") + ":" + os.environ.get("PATH", "")

DEFAULTS = {
    "arxiv_categories": ["hep-th", "quant-ph"],
    "keywords": {"core": [], "broad": [], "accessible": [], "related": []},
    "min_score": 2,
    "authors": [],
    "news_feeds": {},
    "profile": "A physics graduate student working on quantum field theory.",
    "claude_summary": False,
    "claude_picks": 5,
    "foryou_per_day": 3,
    "news_per_day": 2,
    "papers_dir": "~/Papers",
    "ask_claude_url": "https://claude.ai/new?q={prompt}",
    "claude_pool": 200,
    "check_every_hours": 3,
    "startup_delay_seconds": 60,
    "max_news_notifications": 3,
}


def load_conf():
    cfg = dict(DEFAULTS)
    try:
        with open(CONF) as f:
            cfg.update(json.load(f))
    except Exception:
        pass
    return cfg


# ----------------------------------------------------------------- storage
TAB_WHERE = {
    "picks": "kind='paper' AND pick=1",
    "foryou": "kind='paper' AND featured=1",
    "news": "kind='news'",
    "saved": "saved=1",
}

class Store:
    def __init__(self, path):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        self.lock = threading.Lock()
        self.db = sqlite3.connect(path, check_same_thread=False)
        self.db.row_factory = sqlite3.Row
        self.db.executescript("""
            CREATE TABLE IF NOT EXISTS items(
                id TEXT PRIMARY KEY, kind TEXT, source TEXT, title TEXT, link TEXT,
                authors TEXT DEFAULT '', summary TEXT DEFAULT '', score INTEGER DEFAULT 0,
                tags TEXT DEFAULT '', pick INTEGER DEFAULT 0, why TEXT DEFAULT '',
                level TEXT DEFAULT '', added REAL, read INTEGER DEFAULT 0);
            CREATE TABLE IF NOT EXISTS meta(key TEXT PRIMARY KEY, value TEXT);
        """)
        for col, typ in (("featured", "INTEGER DEFAULT 0"), ("dismissed", "INTEGER DEFAULT 0"),
                         ("saved", "INTEGER DEFAULT 0"), ("note", "TEXT DEFAULT ''"),
                         ("explain", "TEXT DEFAULT ''"), ("bibtex", "TEXT DEFAULT ''")):
            try:
                self.db.execute(f"ALTER TABLE items ADD COLUMN {col} {typ}")
            except sqlite3.OperationalError:
                pass
        self.db.commit()

    def add(self, d):
        with self.lock:
            cur = self.db.execute(
                "INSERT OR IGNORE INTO items(id,kind,source,title,link,authors,summary,score,tags,added,read)"
                " VALUES(?,?,?,?,?,?,?,?,?,?,?)",
                (d["id"], d["kind"], d.get("source", ""), d.get("title", ""), d.get("link", ""),
                 d.get("authors", ""), d.get("summary", ""), d.get("score", 0),
                 ", ".join(d.get("tags", [])), time.time(), 1 if d.get("archived") else 0))
            self.db.commit()
            return cur.rowcount == 1

    def set_pick(self, item_id, why, level):
        with self.lock:
            self.db.execute("UPDATE items SET pick=1, why=?, level=? WHERE id=?", (why, level, item_id))
            self.db.commit()

    def set_featured(self, item_id):
        with self.lock:
            self.db.execute("UPDATE items SET featured=1 WHERE id=?", (item_id,))
            self.db.commit()

    def mark_read(self, item_id):
        with self.lock:
            self.db.execute("UPDATE items SET read=1 WHERE id=?", (item_id,))
            self.db.commit()

    def dismiss(self, item_id):
        with self.lock:
            self.db.execute("UPDATE items SET dismissed=1, read=1, saved=0 WHERE id=?", (item_id,))
            self.db.commit()

    def set_field(self, item_id, field, value):
        assert field in ("saved", "note", "explain", "bibtex")
        with self.lock:
            self.db.execute(f"UPDATE items SET {field}=? WHERE id=?", (value, item_id))
            self.db.commit()

    SURFACED = "(pick=1 OR featured=1 OR kind='news')"

    def _latest_day_bounds(self):
        r = self.db.execute(f"SELECT MAX(added) FROM items WHERE {self.SURFACED}").fetchone()[0]
        if not r:
            return None
        t = time.localtime(r)
        start = time.mktime((t.tm_year, t.tm_mon, t.tm_mday, 0, 0, 0, 0, 0, -1))
        return start, start + 86400

    def deleted_in_latest(self):
        with self.lock:
            b = self._latest_day_bounds()
            if not b:
                return 0
            return self.db.execute(
                f"SELECT COUNT(*) FROM items WHERE dismissed=1 AND {self.SURFACED} AND added>=? AND added<?",
                b).fetchone()[0]

    def restore_latest(self):
        """Bring back everything deleted from the most recent day's items, as unread."""
        with self.lock:
            b = self._latest_day_bounds()
            if not b:
                return 0
            cur = self.db.execute(
                f"UPDATE items SET dismissed=0, read=0 WHERE dismissed=1 AND {self.SURFACED} "
                "AND added>=? AND added<?", b)
            self.db.commit()
            return cur.rowcount

    def get(self, item_id):
        with self.lock:
            return self.db.execute("SELECT * FROM items WHERE id=?", (item_id,)).fetchone()

    def tab_counts(self):
        with self.lock:
            return {tab: self.db.execute(
                f"SELECT COUNT(*) FROM items WHERE read=0 AND dismissed=0 AND {TAB_WHERE[tab]}").fetchone()[0]
                for tab in TAB_WHERE}

    def mark_all_read(self):
        with self.lock:
            self.db.execute("UPDATE items SET read=1")
            self.db.commit()

    def unread(self, min_score):
        with self.lock:
            return self.db.execute(
                "SELECT COUNT(*) FROM items WHERE read=0 AND dismissed=0 AND (kind='news' OR pick=1 OR featured=1)"
            ).fetchone()[0]

    def query(self, tab, search, min_score=0):
        where = TAB_WHERE[tab] + " AND dismissed=0"
        args = []
        if search:
            where += " AND (title LIKE ? OR summary LIKE ? OR authors LIKE ? OR tags LIKE ? OR note LIKE ?)"
            args = ["%" + search + "%"] * 5
        order = "CAST(added/86400 AS INTEGER) DESC, pick DESC, score DESC, added DESC"
        with self.lock:
            return self.db.execute(
                f"SELECT * FROM items WHERE {where} ORDER BY {order} LIMIT 300", args).fetchall()

    def get_meta(self, key, default=None):
        with self.lock:
            r = self.db.execute("SELECT value FROM meta WHERE key=?", (key,)).fetchone()
        return r[0] if r else default

    def set_meta(self, key, value):
        with self.lock:
            self.db.execute("INSERT OR REPLACE INTO meta(key,value) VALUES(?,?)", (key, str(value)))
            self.db.commit()

    def prune(self):
        """Forget ordinary papers after 30 days; keep picks, matches and news for a year (saved/noted forever)."""
        now = time.time()
        with self.lock:
            self.db.execute("DELETE FROM items WHERE kind='paper' AND pick=0 AND score<2 AND saved=0 "
                            "AND note='' AND added<?", (now - 30 * 86400,))
            self.db.execute("DELETE FROM items WHERE saved=0 AND note='' AND added<?", (now - 365 * 86400,))
            self.db.commit()


def write_unread(store, cfg):
    """The panel item reads this tiny file instead of starting Python."""
    os.makedirs(CACHE, exist_ok=True)
    tmp = os.path.join(CACHE, "unread.tmp")
    with open(tmp, "w") as f:
        f.write(str(store.unread(cfg["min_score"])))
    os.replace(tmp, os.path.join(CACHE, "unread"))


def locked_fetch(cfg, store, log=print):
    """Run one fetch unless another one (window or service) is already running."""
    import fcntl
    os.makedirs(CACHE, exist_ok=True)
    lf = open(os.path.join(CACHE, "fetch.lock"), "w")
    try:
        fcntl.flock(lf, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return None
    try:
        return run_fetch(cfg, store, log)
    finally:
        fcntl.flock(lf, fcntl.LOCK_UN)
        lf.close()


# ----------------------------------------------------------------- fetching
def fetch(url):
    req = urllib.request.Request(url, headers={"User-Agent": "physics-digest/1.0"})
    with urllib.request.urlopen(req, timeout=30) as r:
        return r.read()


def local(tag):
    return tag.rsplit("}", 1)[-1]


def feed_items(xml_bytes):
    root = ET.fromstring(xml_bytes)
    for el in root.iter():
        if local(el.tag) not in ("item", "entry"):
            continue
        d = {}
        for ch in el:
            name = local(ch.tag)
            if name == "link" and ch.get("href"):
                d.setdefault("link", ch.get("href"))
            elif ch.text:
                d.setdefault(name, ch.text.strip())
        yield d


def clean(s):
    return re.sub(r"\s+", " ", re.sub(r"<[^>]+>", " ", html.unescape(s or ""))).strip()


def norm(t):
    return re.sub(r"[\u2010-\u2015\u2212]", "-", (t or "").lower())


def run_fetch(cfg, store, log=print):
    new = {"papers": [], "news": [], "picks": [], "featured": []}
    kw = cfg.get("keywords", {})
    tiers = {"core": 3, "broad": 2, "accessible": 2, "related": 1}
    if isinstance(kw, list):
        kw = {"related": kw}
    weighted = [(norm(k), w) for t, w in tiers.items() for k in kw.get(t, [])]

    # arXiv
    for cat in cfg["arxiv_categories"]:
        try:
            data = fetch(f"https://rss.arxiv.org/rss/{cat}")
        except Exception as e:
            log(f"arXiv {cat}: {e}")
            continue
        for it in feed_items(data):
            link = it.get("link", "")
            desc = clean(it.get("description", ""))
            kind = (it.get("announce_type") or "").lower()
            if not kind:
                m = re.search(r"Announce Type:\s*(\S+)", desc)
                kind = m.group(1).lower() if m else "new"
            if kind not in ("new", "cross") or not link:
                continue
            title = clean(it.get("title", ""))
            abstract = desc.split("Abstract:", 1)[-1].strip()
            authors = clean(it.get("creator", ""))
            text = norm(title + " " + abstract)
            tags, score = [], 0
            for k, w in weighted:
                if k in text:
                    tags.append(k)
                    score += w
            for a in cfg.get("authors", []):
                if norm(a) in norm(authors):
                    tags.append(a)
                    score += 4
            d = dict(id=link, kind="paper", source=cat, title=title, link=link, authors=authors,
                     summary=abstract, score=score, tags=tags)
            if store.add(d):
                new["papers"].append(d)

    # Claude picks
    if cfg.get("claude_summary") and new["papers"] and shutil.which("claude"):
        pool = sorted(new["papers"], key=lambda p: -p["score"])[: cfg["claude_pool"]]
        listing = "\n".join(f"[{i+1}] ({p['source']}) {p['title']} :: {p['summary'][:250]}"
                            for i, p in enumerate(pool))
        n = cfg["claude_picks"]
        prompt = (
            "Researcher profile: " + cfg["profile"] + "\n\n"
            f"Below are today's new arXiv papers. Pick the {n} most interesting ones for this person. "
            "Do not only pick papers close to their own research: also include conceptually interesting "
            "papers in their fields with a new idea, a surprising result, or a good review or lecture notes, "
            "that someone with their background can follow. Always include papers directly related to their "
            "research if there are any.\n"
            "Write exactly one line per pick in this format and nothing else:\n"
            "N | Why it is interesting (1-2 sentences, English) | Easy/Medium/Advanced\n\n" + listing)
        try:
            r = subprocess.run(["claude", "-p", prompt], capture_output=True, text=True, timeout=600)
            for line in r.stdout.splitlines():
                parts = [x.strip() for x in line.split("|")]
                if len(parts) >= 3 and parts[0].strip("[]. ").isdigit():
                    i = int(parts[0].strip("[]. ")) - 1
                    if 0 <= i < len(pool):
                        level = parts[-1].replace("Level:", "").strip()
                        store.set_pick(pool[i]["id"], parts[1], level)
                        new["picks"].append(dict(pool[i], why=parts[1], level=level))
        except Exception as e:
            log(f"claude: {e}")

    # "For you": the best few keyword matches that are not already picks
    picked = {p["id"] for p in new["picks"]}
    matched = sorted((p for p in new["papers"] if p["score"] >= cfg["min_score"] and p["id"] not in picked),
                     key=lambda p: -p["score"])
    new["featured"] = matched[: cfg["foryou_per_day"]]
    for p in new["featured"]:
        store.set_featured(p["id"])

    # news: only a couple a day stay unread, the rest go straight to the archive
    today = time.strftime("%Y-%m-%d")
    if store.get_meta("news_day") != today:
        store.set_meta("news_day", today)
        store.set_meta("news_count", 0)
    news_left = cfg["news_per_day"] - int(store.get_meta("news_count", 0) or 0)
    for name, url in cfg.get("news_feeds", {}).items():
        try:
            data = fetch(url)
        except Exception as e:
            log(f"{name}: {e}")
            continue
        for it in list(feed_items(data))[:15]:
            nid = it.get("link") or it.get("guid") or it.get("id")
            if not nid:
                continue
            d = dict(id=nid, kind="news", source=name, title=clean(it.get("title", "")),
                     link=it.get("link", nid),
                     summary=clean(it.get("description") or it.get("summary") or "")[:400],
                     archived=news_left <= 0)
            if store.add(d) and news_left > 0:
                new["news"].append(d)
                news_left -= 1
    store.set_meta("news_count", cfg["news_per_day"] - max(news_left, 0))

    store.set_meta("last_fetch", time.time())
    store.prune()
    return new


# ----------------------------------------------------------------- background service
def main_daemon():
    from gi.repository import GLib, Gio
    cfg = load_conf()
    store = Store(DB)
    loop = GLib.MainLoop()
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)
    state = {"owned": False, "fetching": False}
    actions = {}

    def log(m):
        print(m, file=sys.stderr, flush=True)

    # single instance + tiny control interface (Refresh / Quit)
    xml = ("<node><interface name='org.physicsdigest.PhysicsDigest.Daemon'>"
           "<method name='Refresh'/><method name='Quit'/></interface></node>")
    iface = Gio.DBusNodeInfo.new_for_xml(xml).interfaces[0]

    def on_call(conn, sender, path, iname, method, params, inv):
        if method == "Refresh":
            refresh()
        elif method == "Quit":
            GLib.idle_add(loop.quit)
        inv.return_value(None)

    def on_acquired(conn, name):
        state["owned"] = True

    def on_lost(conn, name):
        if not state["owned"]:
            log("Physics Digest service is already running.")
        loop.quit()

    bus.register_object(BUS_PATH, iface, on_call, None, None)
    Gio.bus_own_name_on_connection(bus, BUS_NAME, Gio.BusNameOwnerFlags.NONE, on_acquired, on_lost)

    # notifications straight over D-Bus (no GTK, no libnotify)
    def on_signal(conn, sender, path, iname, signal, params):
        if signal == "ActionInvoked":
            nid, _key = params.unpack()
            fn = actions.pop(nid, None)
            if fn:
                fn()
        elif signal == "NotificationClosed":
            actions.pop(params.unpack()[0], None)

    bus.signal_subscribe("org.freedesktop.Notifications", "org.freedesktop.Notifications", None,
                         "/org/freedesktop/Notifications", None, Gio.DBusSignalFlags.NONE, on_signal)

    def notify(summary, body, fn):
        icon = ICON if os.path.exists(ICON) else "accessories-dictionary"
        try:
            res = bus.call_sync(
                "org.freedesktop.Notifications", "/org/freedesktop/Notifications",
                "org.freedesktop.Notifications", "Notify",
                GLib.Variant("(susssasa{sv}i)", ("Physics Digest", 0, icon, summary, body,
                                                 ["default", "Open"], {}, -1)),
                GLib.VariantType("(u)"), Gio.DBusCallFlags.NONE, -1, None)
            actions[res.unpack()[0]] = fn
        except Exception as e:
            log(f"notify: {e}")

    def launch(*args):
        os.makedirs(CACHE, exist_ok=True)
        with open(os.path.join(CACHE, "window.log"), "a") as logf:
            subprocess.Popen([sys.executable, SELF, *args], start_new_session=True,
                             stdout=logf, stderr=logf)

    def open_window(tab):
        launch("--tab", tab)

    def open_item(item_id, link=None):
        launch("--show", item_id)

    def announce(res):
        if res["picks"]:
            body = "\n".join("• " + p["title"][:90] for p in res["picks"][:5])
            notify(f"Today's picks: {len(res['picks'])} papers", body, lambda: open_window("picks"))
        elif res["featured"]:
            body = "\n".join("• " + p["title"][:90] for p in res["featured"])
            notify(f"{len(res['featured'])} new papers for you", body, lambda: open_window("foryou"))
        for nw in res["news"][: cfg["max_news_notifications"]]:
            notify(nw["source"], nw["title"], lambda nw=nw: open_item(nw["id"], nw["link"]))

    def done(res):
        state["fetching"] = False
        if res:
            announce(res)
        write_unread(store, cfg)
        return False

    def worker():
        try:
            res = locked_fetch(cfg, Store(DB), log)
        except Exception as e:
            log(f"fetch failed: {e}")
            res = None
        GLib.idle_add(done, res)

    def refresh():
        nonlocal cfg
        if state["fetching"]:
            return
        state["fetching"] = True
        cfg = load_conf()
        threading.Thread(target=worker, daemon=True).start()

    def tick():
        last = float(store.get_meta("last_fetch", 0) or 0)
        if time.time() - last >= cfg["check_every_hours"] * 3600:
            refresh()
        else:
            write_unread(store, cfg)
        return True

    write_unread(store, cfg)
    GLib.timeout_add_seconds(int(cfg["startup_delay_seconds"]), lambda: tick() and False)
    GLib.timeout_add_seconds(15 * 60, tick)
    loop.run()


def call_daemon(method):
    from gi.repository import Gio
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        bus.call_sync(BUS_NAME, BUS_PATH, BUS_NAME, method, None, None,
                      Gio.DBusCallFlags.NO_AUTO_START, 5000, None)
        return True
    except Exception:
        return False


