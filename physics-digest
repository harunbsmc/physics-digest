def arxiv_id(link):
    m = re.match(r"https?://arxiv\.org/abs/([^?#]+)", link or "")
    return m.group(1) if m else None


def fallback_bibtex(it):
    aid = arxiv_id(it["link"]) or ""
    authors = " and ".join(a.strip() for a in (it["authors"] or "").split(",") if a.strip())
    first = (authors.split(" and ")[0].split()[-1] if authors else "anon").lower()
    year = "20" + aid[:2] if re.match(r"\d{4}\.", aid) else time.strftime("%Y")
    key = re.sub(r"[^a-z]", "", first) + year
    return (f"@misc{{{key},\n  title = {{{it['title']}}},\n  author = {{{authors}}},\n  year = {{{year}}},\n"
            f"  eprint = {{{aid}}},\n  archivePrefix = {{arXiv}},\n  primaryClass = {{{it['source']}}}\n}}")


